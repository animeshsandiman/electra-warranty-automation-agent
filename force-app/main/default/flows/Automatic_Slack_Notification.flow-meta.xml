<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Buttons_for_Review</name>
        <label>Buttons for Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>SlackFlowAction</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Review_In_Progress</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>messages</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>SlackFlowAction</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <name>Approved</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Approved</stringValue>
        </value>
    </constants>
    <constants>
        <name>Rejected</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Rejected</stringValue>
        </value>
    </constants>
    <constants>
        <name>ReviewInProgress</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Review In Progress</stringValue>
        </value>
    </constants>
    <constants>
        <name>SlackChannelId</name>
        <dataType>String</dataType>
        <value>
            <stringValue>C0ASMAEGFC0</stringValue>
        </value>
    </constants>
    <decisions>
        <name>Check_Warranty_Eligibility</name>
        <label>Check Warranty Eligibility</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Reject</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Auto Rejected</defaultConnectorLabel>
        <rules>
            <name>Auto_approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Today_date</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>WarrantyEndDate_1year</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approve</targetReference>
            </connector>
            <label>Auto Approve</label>
        </rules>
        <rules>
            <name>Send_For_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Today_date</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>WarrantyEndDate_1year</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Today_date</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>ExtendedEndDate_2years</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Buttons_for_Review</targetReference>
            </connector>
            <label>Send For Review</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>ExtendedEndDate_2years</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Extracted_Date_Converted__c} + 730</expression>
    </formulas>
    <formulas>
        <name>Today_date</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <formulas>
        <name>WarrantyEndDate_1year</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Extracted_Date_Converted__c} + 365</expression>
    </formulas>
    <interviewLabel>Automatic {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Automatic Slack Notification</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Approve</name>
        <label>Approve</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>Approved</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Reject</name>
        <label>Reject</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>Rejected</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Review_In_Progress</name>
        <label>Review In Progress</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>ReviewInProgress</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Extract_Invoice_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Warranty_Claim_Intake__c</object>
        <recordTriggerType>Update</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Check_Warranty_Eligibility</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>SlackMessageTemplate</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>🚗 *New Warranty Claim Alert*
• Claim Number: {!$Record.Name}
• VIN: {!$Record.VIN__c}
• Vehicle Type: {!$Record.Vehicle_Type__c}
• Part: {!$Record.Part_Name__c}
• Issue Description: {!$Record.Issue_Description__c}
• Dealer: {!$Record.Dealer_Name__c}
• Invoice Date: {!$Record.Invoice_Date__c}</text>
    </textTemplates>
</Flow>
